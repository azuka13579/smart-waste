Project smart_waste {
  database_type: 'PostgreSQL'
  Note: 'PostgreSQL 18+ (uuidv7). Sumber kebenaran: backend/src/database/schema/'
}

Enum user_role {
  admin
  user
}

Enum report_status {
  pending
  in_progress
  completed
  rejected
}

Enum waste_category {
  glass
  metal
  organic
  paper
  plastic
  textile
}

Table users {
  id uuid [pk, default: `uuidv7()`]
  name varchar(100) [not null]
  email varchar(255) [not null, unique, note: 'Selalu huruf kecil']
  password varchar(255) [not null, note: 'Hash argon2id']
  role user_role [not null, default: 'user']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table user_sessions {
  id uuid [pk, default: `uuidv7()`]
  user_id uuid [not null]
  token text [not null, unique]
  ip_address text [not null]
  user_agent text [not null]
  expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
  }
}

Table reports {
  id uuid [pk, default: `uuidv7()`]
  user_id uuid [not null, ref: > users.id]
  description text [not null]
  photo_key varchar(255) [not null, note: 'Object key di storage (R2 / lokal)']
  latitude numeric(9,6) [not null]
  longitude numeric(9,6) [not null]
  address text
  category waste_category [note: 'Kategori final (Model atau pilihan manual)']
  model_category waste_category [note: 'Hasil model; null jika tidak dikenali']
  model_confidence real [note: '0-1']
  status report_status [not null, default: 'pending']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
    status
    created_at
    category
  }
}

Table report_status_logs {
  id uuid [pk, default: `uuidv7()`]
  report_id uuid [not null]
  changed_by uuid [not null, ref: > users.id]
  from_status report_status [note: 'null saat laporan dibuat']
  to_status report_status [not null]
  note text [note: 'Mis. alasan laporan ditolak']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    report_id
  }
}

Ref: report_status_logs.report_id > reports.id [delete: cascade]
Ref: user_sessions.user_id > users.id [delete: cascade]
