SERVER_PORT=8080
# 0.0.0.0 agar bisa diakses dari HP di jaringan yang sama
SERVER_HOST=0.0.0.0

# Minimal 32 karakter; dipakai untuk enkripsi token sesi (AES-256)
APP_SECRET=ganti-dengan-string-acak-minimal-32-karakter
# URL publik backend ini, dipakai untuk membentuk URL foto saat STORAGE_DRIVER=local
APP_BASE_URL=http://localhost:8080
# Domain yang boleh mengakses API saat production (pisahkan dengan koma). Saat development semua origin diizinkan.
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/smart_waste

# Admin awal; dibuat otomatis saat start jika email belum terdaftar
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@smartwaste.id
ADMIN_PASSWORD=admin12345

# local = simpan foto di folder ./uploads, s3 = Cloudflare R2 / S3
STORAGE_DRIVER=local
S3_API_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=smart-waste
S3_REGION=auto
S3_PUBLIC_URL=https://pub-xxxx.r2.dev

# Model klasifikasi (salin dari ml/models/)
MODEL_PATH=models/waste_classifier.onnx
MODEL_LABELS_PATH=models/labels.json
# Di bawah ambang ini hasil prediksi dianggap "tidak dikenali"
MODEL_CONFIDENCE_THRESHOLD=0.6
