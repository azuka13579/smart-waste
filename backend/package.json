{
	"name": "smart-waste-backend",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun run --elide-lines=0 --watch --hot src/index.ts | pino-pretty -c -t 'HH:mm:ss' -i pid,hostname,time -S",
		"start": "bun run src/index.ts",
		"db:generate": "drizzle-kit generate",
		"seed:demo": "bun run src/database/seed-demo.ts",
		"check": "biome check",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"prepare": "lefthook install"
	},
	"exports": {
		".": {
			"import": "./src/type.ts",
			"default": "./src/type.ts",
			"types": "./src/type.ts"
		}
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		],
		"rules": {
			"body-max-line-length": [
				0
			]
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@tsconfig/bun": "^1.0.11",
		"@types/bun": "^1.4.4",
		"drizzle-kit": "^0.31.11",
		"lefthook": "^2.2.2",
		"pino-pretty": "^13.2.0",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@elysiajs/cors": "^1.4.2",
		"@elysiajs/openapi": "^1.4.16",
		"@sapphire/bitfield": "^1.2.4",
		"@sapphire/result": "^2.8.0",
		"drizzle-orm": "^0.45.4",
		"drizzle-zod": "^0.8.3",
		"elysia": "^1.4.30",
		"onnxruntime-node": "^1.31.1",
		"pino": "^10.4.0",
		"postgres": "^3.4.9",
		"sharp": "^0.35.5",
		"zod": "^4.6.7"
	}
}
