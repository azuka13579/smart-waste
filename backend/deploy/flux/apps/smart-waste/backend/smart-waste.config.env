NODE_ENV=production
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

APP_BASE_URL=https://api.smartwaste.example.com
CORS_ORIGINS=https://smartwaste.example.com

ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@smartwaste.example.com

STORAGE_DRIVER=s3
S3_API_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET_NAME=smart-waste
S3_REGION=auto
S3_PUBLIC_URL=https://pub-xxxx.r2.dev

MODEL_CONFIDENCE_THRESHOLD=0.6
